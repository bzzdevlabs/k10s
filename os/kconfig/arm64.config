# arm64 profile: one kernel for QEMU virt and arm64 cloud guests (UEFI or DT; virtio, PL011, PL031, i6300esb) and
# the Raspberry Pi 3, 4 and 5 (BCM2837; BCM2711; BCM2712 with the RP1 south bridge), every driver built in (no
# modules). UEFI boots the Image (an EFI application) through a UKI; the Pi firmware loads Image.gz and the board's
# devicetree.
CONFIG_NR_CPUS=64
CONFIG_MODULES=n
CONFIG_ARM64_4K_PAGES=y
CONFIG_ARM64_VA_BITS_48=y
# membarrier: the JIT context-synchronizes every thread after mapping new code (PRIVATE_EXPEDITED_SYNC_CORE)
CONFIG_MEMBARRIER=y
CONFIG_EFI=y
CONFIG_EFI_STUB=y
# efivarfs (read-only): init reads systemd-boot's LoaderEntrySelected to know the booted A/B slot
CONFIG_EFIVAR_FS=y
# UEFI machines boot with ACPI (QEMU's AAVMF, SystemReady servers): the power button signals init (tiny driver), the
# clock is the firmware's RTC
CONFIG_ACPI=y
CONFIG_ACPI_BUTTON=n
CONFIG_ACPI_TINY_POWER_BUTTON=y
CONFIG_RTC_DRV_EFI=y
# --- generic platform: PCIe (ECAM), GICv3 ITS, PL011 console, PL031 RTC, power key on PL061 (gpio-keys)
CONFIG_PCI=y
CONFIG_PCI_HOST_GENERIC=y
CONFIG_PCI_MSI=y
CONFIG_PCIEPORTBUS=y
CONFIG_ARM_GIC_V3_ITS=y
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y
CONFIG_RTC_DRV_PL031=y
CONFIG_GPIOLIB=y
CONFIG_GPIO_PL061=y
CONFIG_KEYBOARD_GPIO=y
# --- virtio (QEMU virt, cloud guests), the QEMU PCI watchdog
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_BLK=y
CONFIG_HW_RANDOM_VIRTIO=y
CONFIG_I6300ESB_WDT=y
# --- Raspberry Pi: SoC, firmware mailbox and clocks, pin control, regulators
CONFIG_ARCH_BCM=y
CONFIG_ARCH_BCM2835=y
CONFIG_ARCH_BRCMSTB=y
CONFIG_MAILBOX=y
CONFIG_BCM2835_MBOX=y
CONFIG_RASPBERRYPI_FIRMWARE=y
CONFIG_RASPBERRYPI_POWER=y
CONFIG_RESET_RASPBERRYPI=y
CONFIG_CLK_RASPBERRYPI=y
CONFIG_COMMON_CLK_RP1=y
CONFIG_PINCTRL_BCM2835=y
CONFIG_PINCTRL_BRCMSTB=y
CONFIG_PINCTRL_BCM2712=y
CONFIG_PINCTRL_RP1=y
CONFIG_REGULATOR=y
CONFIG_REGULATOR_FIXED_VOLTAGE=y
CONFIG_REGULATOR_GPIO=y
# 6.18.57: PINCTRL_RP1 uses regmap without selecting it; any REGMAP_MMIO user pulls it in
CONFIG_MFD_SYSCON=y
CONFIG_CPU_FREQ=y
CONFIG_CPU_FREQ_DEFAULT_GOV_PERFORMANCE=y
CONFIG_ARM_RASPBERRYPI_CPUFREQ=y
# --- Pi PCIe (Pi 4: VL805 USB 3; Pi 5: RP1, NVMe) and the RP1 south bridge (its devicetree is an overlay)
CONFIG_PCIE_BRCMSTB=y
CONFIG_PCI_QUIRKS=y
CONFIG_OF_OVERLAY=y
CONFIG_MISC_RP1=y
# --- Pi storage: SD (Pi 3 SDHOST, which waits for its DMA controller; Pi 4 EMMC2, Pi 5 SDHCI), NVMe, USB mass storage
CONFIG_DMADEVICES=y
CONFIG_DMA_BCM2835=y
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PLTFM=y
CONFIG_MMC_SDHCI_IPROC=y
CONFIG_MMC_SDHCI_BRCMSTB=y
CONFIG_MMC_BCM2835=y
CONFIG_BLK_DEV_NVME=y
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_USB_SUPPORT=y
CONFIG_USB=y
CONFIG_USB_PCI=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_PCI=y
CONFIG_USB_XHCI_PLATFORM=y
CONFIG_USB_DWC2=y
CONFIG_USB_STORAGE=y
CONFIG_USB_UAS=y
# --- Ethernet: Pi 4 GENET, Pi 5 Cadence GEM (RP1), their BCM54213PE PHY; USB Ethernet (the Pi 3's LAN9514 is
# smsc95xx behind dwc2, the Pi 3 B+'s LAN7515 lan78xx) and adapters
CONFIG_NET_VENDOR_BROADCOM=y
CONFIG_BCMGENET=y
CONFIG_NET_VENDOR_CADENCE=y
CONFIG_MACB=y
CONFIG_PHYLIB=y
CONFIG_BROADCOM_PHY=y
CONFIG_USB_NET_DRIVERS=y
CONFIG_USB_RTL8152=y
CONFIG_USB_USBNET=y
CONFIG_USB_NET_AX8817X=y
CONFIG_USB_NET_AX88179_178A=y
CONFIG_USB_NET_CDCETHER=y
CONFIG_USB_NET_CDC_NCM=y
CONFIG_USB_NET_SMSC95XX=y
CONFIG_USB_LAN78XX=y
# --- Pi watchdog (PID 1 pets it), hardware RNGs, consoles (mini UART; PL011 is in the generic part)
CONFIG_BCM2835_WDT=y
CONFIG_HW_RANDOM_BCM2835=y
CONFIG_HW_RANDOM_IPROC_RNG200=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_EXTENDED=y
CONFIG_SERIAL_8250_BCM2835AUX=y
CONFIG_SERIAL_8250_SHARE_IRQ=y
CONFIG_SERIAL_OF_PLATFORM=y
# --- Cortex-A53 (Pi 3): erratum 843419, worked around by the linker
CONFIG_ARM64_ERRATUM_843419=y

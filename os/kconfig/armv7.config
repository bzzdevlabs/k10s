# armv7 profile: a 32-bit ARM (ARMv7-A, hard-float) kernel for QEMU virt and other UEFI machines that pass a
# devicetree (EBBR boards with U-Boot's UEFI): GIC, architected timer, PSCI, PL011, PL031, PCIe (ECAM), virtio, the
# `gpio-keys` power key on PL061, i6300esb; every driver built in (no modules). UEFI boots the zImage (an EFI
# application) through a UKI. SoC-specific drivers (clocks, pin control, Ethernet MACs of real boards) are not in it.
CONFIG_MMU=y
CONFIG_ARCH_MULTIPLATFORM=y
CONFIG_ARCH_MULTI_V7=y
CONFIG_ARCH_VIRT=y
CONFIG_ARM_THUMB=y
CONFIG_VFP=y
CONFIG_VFPv3=y
CONFIG_NEON=y
CONFIG_HIGHMEM=y
CONFIG_NR_CPUS=8
CONFIG_ARM_PSCI=y
CONFIG_MODULES=n
CONFIG_KERNEL_GZIP=y
# musl calls the time32 syscalls when a value fits in 32 bits (nanosleep, clock_nanosleep, futex)
CONFIG_COMPAT_32BIT_TIME=y
CONFIG_EFI=y
CONFIG_EFI_STUB=y
# efivarfs (read-only): init reads systemd-boot's LoaderEntrySelected to know the booted A/B slot
CONFIG_EFIVAR_FS=y
# UEFI keeps the PL031 for its runtime services (and disables it in the devicetree): the clock is the EFI RTC
CONFIG_RTC_DRV_EFI=y
# --- PCIe (ECAM), PL011 console, PL031 RTC, power key on PL061 (gpio-keys)
CONFIG_PCI=y
CONFIG_PCI_HOST_GENERIC=y
CONFIG_PCI_MSI=y
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y
CONFIG_RTC_DRV_PL031=y
CONFIG_GPIOLIB=y
CONFIG_GPIO_PL061=y
CONFIG_KEYBOARD_GPIO=y
# --- virtio (PCI and MMIO), the QEMU PCI watchdog
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_BLK=y
CONFIG_HW_RANDOM_VIRTIO=y
CONFIG_I6300ESB_WDT=y

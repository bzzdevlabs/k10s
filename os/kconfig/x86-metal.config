# x86 real-machine profile (PCs, mini-PCs, servers): platform, storage, USB host and console built in; NICs,
# USB Ethernet and watchdogs as signed modules (os/kbuild.sh signs them and deletes the key).
CONFIG_KERNEL_ZSTD=y
CONFIG_NR_CPUS=512
CONFIG_NUMA=y
CONFIG_X86_X2APIC=y
CONFIG_X86_MCE=y
CONFIG_X86_MCE_INTEL=y
CONFIG_X86_MCE_AMD=y
CONFIG_MICROCODE=y
CONFIG_HYPERVISOR_GUEST=y
CONFIG_PARAVIRT=y
CONFIG_KVM_GUEST=y
CONFIG_EFI=y
CONFIG_EFI_STUB=y
# efivarfs (read-only): init reads systemd-boot's LoaderEntrySelected to know the booted A/B slot
CONFIG_EFIVAR_FS=y
CONFIG_EARLY_PRINTK=y
# --- modules: signed (SHA-512), signatures enforced, zstd-compressed (the kernel decompresses them)
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=n
CONFIG_MODULE_SIG=y
CONFIG_MODULE_SIG_FORCE=y
CONFIG_MODULE_SIG_ALL=y
CONFIG_MODULE_SIG_SHA512=y
CONFIG_MODULE_SIG_KEY_TYPE_RSA=y
CONFIG_MODULE_COMPRESS=y
CONFIG_MODULE_COMPRESS_ZSTD=y
CONFIG_MODULE_DECOMPRESS=y
# --- ACPI: power button (the tiny driver signals init; in 6.18 only it handles fixed-feature buttons), processor
# idle and thermal protection, frequency scaling
CONFIG_ACPI=y
CONFIG_ACPI_BUTTON=n
CONFIG_ACPI_TINY_POWER_BUTTON=y
CONFIG_ACPI_PROCESSOR=y
CONFIG_ACPI_THERMAL=y
CONFIG_ACPI_FAN=y
CONFIG_CPU_IDLE=y
CONFIG_INTEL_IDLE=y
CONFIG_CPU_FREQ=y
CONFIG_X86_INTEL_PSTATE=y
CONFIG_X86_AMD_PSTATE=y
CONFIG_X86_ACPI_CPUFREQ=y
CONFIG_THERMAL=y
# --- PCI, MSI, DMA remapping (IOMMU on by default)
CONFIG_PCI=y
CONFIG_PCI_MSI=y
CONFIG_PCIEPORTBUS=y
CONFIG_IOMMU_SUPPORT=y
CONFIG_INTEL_IOMMU=y
CONFIG_INTEL_IOMMU_DEFAULT_ON=y
CONFIG_AMD_IOMMU=y
CONFIG_IRQ_REMAP=y
# --- storage: SATA (AHCI, legacy Intel), NVMe, USB mass storage, eMMC/SD, virtio
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_ATA=y
CONFIG_SATA_AHCI=y
CONFIG_ATA_PIIX=y
CONFIG_BLK_DEV_NVME=y
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PCI=y
CONFIG_MMC_SDHCI_ACPI=y
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y
CONFIG_HW_RANDOM_VIRTIO=y
# --- USB host controllers and storage
CONFIG_USB_SUPPORT=y
CONFIG_USB=y
CONFIG_USB_PCI=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_OHCI_HCD=m
CONFIG_USB_UHCI_HCD=m
CONFIG_USB_STORAGE=y
CONFIG_USB_UAS=y
# --- Ethernet (modules): Intel, Realtek (rtl_nic firmware), Broadcom, Aquantia, Marvell, Atheros, virtio
CONFIG_NET_VENDOR_INTEL=y
CONFIG_E1000=m
CONFIG_E1000E=m
CONFIG_IGB=m
CONFIG_IGC=m
CONFIG_IXGBE=m
CONFIG_I40E=m
CONFIG_ICE=m
CONFIG_NET_VENDOR_REALTEK=y
CONFIG_R8169=m
CONFIG_NET_VENDOR_BROADCOM=y
CONFIG_TIGON3=m
CONFIG_BNX2=m
CONFIG_NET_VENDOR_AQUANTIA=y
CONFIG_AQTION=m
CONFIG_NET_VENDOR_MARVELL=y
CONFIG_SKY2=m
CONFIG_NET_VENDOR_ATHEROS=y
CONFIG_ALX=m
CONFIG_ATL1C=m
CONFIG_VIRTIO_NET=m
# --- USB Ethernet adapters (modules)
CONFIG_USB_NET_DRIVERS=y
CONFIG_USB_RTL8152=m
CONFIG_USB_USBNET=m
CONFIG_USB_NET_AX8817X=m
CONFIG_USB_NET_AX88179_178A=m
CONFIG_USB_NET_CDCETHER=m
CONFIG_USB_NET_CDC_NCM=m
CONFIG_USB_NET_SMSC95XX=m
CONFIG_USB_LAN78XX=m
# --- watchdogs (modules): Intel TCO (behind the LPC bridge or, on newer chipsets, the SMBus controller), AMD
# SP5100/FCH, ACPI WDAT, QEMU i6300esb
CONFIG_LPC_ICH=m
CONFIG_I2C_I801=m
CONFIG_ITCO_WDT=m
CONFIG_SP5100_TCO=m
CONFIG_WDAT_WDT=m
CONFIG_I6300ESB_WDT=m
# --- hardware RNGs, RTC
CONFIG_HW_RANDOM_INTEL=y
CONFIG_HW_RANDOM_AMD=y
CONFIG_RTC_DRV_CMOS=y
# --- consoles: serial, VGA text (BIOS), EFI framebuffer; PC keyboard for Ctrl-Alt-Del
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_VGA_CONSOLE=y
CONFIG_FB=y
CONFIG_FB_EFI=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_SERIO_I8042=y
CONFIG_KEYBOARD_ATKBD=y

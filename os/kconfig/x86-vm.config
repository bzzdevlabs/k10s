# x86 QEMU/KVM guest profile: virtio (PCI, net, block, RNG), i6300esb watchdog, CMOS RTC, ACPI tiny power button.
CONFIG_KERNEL_ZSTD=y
CONFIG_HYPERVISOR_GUEST=y
CONFIG_PARAVIRT=y
CONFIG_KVM_GUEST=y
CONFIG_PVH=y
CONFIG_ACPI=y
CONFIG_ACPI_BUTTON=n
CONFIG_ACPI_TINY_POWER_BUTTON=y
CONFIG_PCI=y
CONFIG_PCI_MSI=y
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_BLK=y
CONFIG_HW_RANDOM_VIRTIO=y
CONFIG_I6300ESB_WDT=y
CONFIG_RTC_DRV_CMOS=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_EARLY_PRINTK=y
CONFIG_X86_X2APIC=y
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_E1000=y
CONFIG_E1000E=y
CONFIG_SCSI=n

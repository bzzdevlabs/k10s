# i386 profile (old PCs, BIOS): a 32-bit kernel for i686 CPUs with PAE and SSE2 (Pentium 4, Pentium M with PAE,
# Core, Atom, Athlon 64, VIA C7 and later; the i686 k10s needs SSE2, and PAE gives the NX bit). Platform, storage
# (IDE/PATA, SATA, USB), USB host and console built in; NICs, USB Ethernet and watchdogs as signed modules, like
# x86-metal.config.
CONFIG_64BIT=n
CONFIG_M686=y
CONFIG_X86_GENERIC=y
CONFIG_X86_PAE=y
CONFIG_HIGHMEM4G=y
CONFIG_NR_CPUS=8
CONFIG_X86_MPPARSE=y
CONFIG_KERNEL_ZSTD=y
# musl calls the time32 syscalls when a value fits in 32 bits (nanosleep, clock_nanosleep, futex)
CONFIG_COMPAT_32BIT_TIME=y
CONFIG_HYPERVISOR_GUEST=y
CONFIG_PARAVIRT=y
CONFIG_KVM_GUEST=y
CONFIG_EARLY_PRINTK=y
# --- modules: signed (SHA-512), signatures enforced, zstd-compressed (the kernel decompresses them)
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=n
CONFIG_MODULE_SIG=y
CONFIG_MODULE_SIG_FORCE=y
CONFIG_MODULE_SIG_ALL=y
CONFIG_MODULE_SIG_SHA512=y
CONFIG_MODULE_SIG_KEY_TYPE_RSA=y
CONFIG_MODULE_COMPRESS=y
CONFIG_MODULE_COMPRESS_ZSTD=y
CONFIG_MODULE_DECOMPRESS=y
# --- ACPI: power button (the tiny driver signals init), processor idle and thermal protection, frequency scaling
CONFIG_ACPI=y
CONFIG_ACPI_BUTTON=n
CONFIG_ACPI_TINY_POWER_BUTTON=y
CONFIG_ACPI_PROCESSOR=y
CONFIG_ACPI_THERMAL=y
CONFIG_ACPI_FAN=y
CONFIG_CPU_IDLE=y
CONFIG_CPU_FREQ=y
CONFIG_X86_ACPI_CPUFREQ=y
CONFIG_THERMAL=y
# --- PCI and MSI
CONFIG_PCI=y
CONFIG_PCI_MSI=y
CONFIG_PCIEPORTBUS=y
# --- storage: IDE/PATA and SATA of the common chipsets (Intel PIIX/ICH, AMD, VIA, SiS, ATI, nVidia, JMicron, Marvell,
# Silicon Image, Promise, ALi, ServerWorks), AHCI, USB mass storage, virtio
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_ATA=y
CONFIG_ATA_SFF=y
CONFIG_ATA_BMDMA=y
CONFIG_SATA_AHCI=y
CONFIG_ATA_PIIX=y
CONFIG_ATA_GENERIC=y
CONFIG_PATA_OLDPIIX=y
CONFIG_PATA_AMD=y
CONFIG_PATA_VIA=y
CONFIG_PATA_SIS=y
CONFIG_PATA_ATIIXP=y
CONFIG_PATA_JMICRON=y
CONFIG_PATA_MARVELL=y
CONFIG_PATA_ALI=y
CONFIG_PATA_SERVERWORKS=y
CONFIG_SATA_VIA=y
CONFIG_SATA_SIS=y
CONFIG_SATA_NV=y
CONFIG_SATA_SIL=y
CONFIG_SATA_PROMISE=y
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y
CONFIG_HW_RANDOM_VIRTIO=y
# --- USB host controllers (UHCI, OHCI, EHCI, xHCI) and storage
CONFIG_USB_SUPPORT=y
CONFIG_USB=y
CONFIG_USB_PCI=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_OHCI_HCD=y
CONFIG_USB_UHCI_HCD=y
CONFIG_USB_STORAGE=y
# --- Ethernet (modules): Realtek RTL8139 and RTL8169/8168/8111 (rtl_nic firmware), Intel PRO/100 and PRO/1000,
# Broadcom, VIA, SiS, nVidia nForce, 3Com, AMD PCnet, Marvell, Atheros, NE2000, DEC Tulip, National Semiconductor,
# virtio
CONFIG_NET_VENDOR_REALTEK=y
CONFIG_8139CP=m
CONFIG_8139TOO=m
CONFIG_R8169=m
CONFIG_NET_VENDOR_INTEL=y
CONFIG_E100=m
CONFIG_E1000=m
CONFIG_E1000E=m
CONFIG_IGB=m
CONFIG_NET_VENDOR_BROADCOM=y
CONFIG_B44=m
CONFIG_TIGON3=m
CONFIG_BNX2=m
CONFIG_NET_VENDOR_VIA=y
CONFIG_VIA_RHINE=m
CONFIG_VIA_VELOCITY=m
CONFIG_NET_VENDOR_SIS=y
CONFIG_SIS900=m
CONFIG_SIS190=m
CONFIG_NET_VENDOR_NVIDIA=y
CONFIG_FORCEDETH=m
CONFIG_NET_VENDOR_3COM=y
CONFIG_VORTEX=m
CONFIG_NET_VENDOR_AMD=y
CONFIG_PCNET32=m
CONFIG_NET_VENDOR_MARVELL=y
CONFIG_SKGE=m
CONFIG_SKY2=m
CONFIG_NET_VENDOR_ATHEROS=y
CONFIG_ATL1=m
CONFIG_ATL1E=m
CONFIG_ATL1C=m
CONFIG_ALX=m
CONFIG_NET_VENDOR_8390=y
CONFIG_NE2K_PCI=m
CONFIG_NET_VENDOR_DEC=y
CONFIG_NET_TULIP=y
CONFIG_TULIP=m
CONFIG_NET_VENDOR_NATSEMI=y
CONFIG_NATSEMI=m
CONFIG_VIRTIO_NET=m
# --- USB Ethernet adapters (modules)
CONFIG_USB_NET_DRIVERS=y
CONFIG_USB_RTL8152=m
CONFIG_USB_USBNET=m
CONFIG_USB_NET_AX8817X=m
CONFIG_USB_NET_AX88179_178A=m
CONFIG_USB_NET_CDCETHER=m
CONFIG_USB_NET_CDC_NCM=m
CONFIG_USB_NET_DM9601=m
CONFIG_USB_NET_SMSC95XX=m
CONFIG_USB_LAN78XX=m
# --- watchdogs (modules): Intel TCO (behind the LPC bridge or the SMBus controller), AMD SP5100/FCH, ACPI WDAT,
# QEMU i6300esb
CONFIG_LPC_ICH=m
CONFIG_I2C_I801=m
CONFIG_ITCO_WDT=m
CONFIG_SP5100_TCO=m
CONFIG_WDAT_WDT=m
CONFIG_I6300ESB_WDT=m
# --- hardware RNGs (Intel, AMD, VIA PadLock), RTC
CONFIG_HW_RANDOM_INTEL=y
CONFIG_HW_RANDOM_AMD=y
CONFIG_HW_RANDOM_VIA=y
CONFIG_RTC_DRV_CMOS=y
# --- consoles: serial, VGA text; PC keyboard for Ctrl-Alt-Del
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_VGA_CONSOLE=y
CONFIG_SERIO_I8042=y
CONFIG_KEYBOARD_ATKBD=y

+/*
+ * reboot(LINUX_REBOOT_CMD_RESTART2, "0 tryboot") sets the firmware's one-shot tryboot flag: the next boot uses the
+ * [tryboot] sections of autoboot.txt and config.txt (A/B updates), as with the Raspberry Pi kernel.
+ */
+static int rpi_firmware_notify_reboot(struct notifier_block *nb, unsigned long action, void *data)
+{
+	struct rpi_firmware *fw = container_of(nb, struct rpi_firmware, reboot_nb);
+	u32 flags = 1;
+
+	if (action == SYS_RESTART && data && strstr(data, "tryboot"))
+		rpi_firmware_property(fw, RPI_FIRMWARE_SET_REBOOT_FLAGS, &flags, sizeof(flags));
+	return NOTIFY_DONE;
+}

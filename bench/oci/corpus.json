  {"name": "redis", "workload": "setpriv entrypoint, SET and INCRBY, BGSAVE (fork), SIGTERM (save on shutdown)", "tag": "redis:8.2",
   "image": "docker.io/library/redis@sha256:e5f23377739f95a2f530b9c99f93accb4f634577f09d00a7d8e0638f2fdf69e0",
   "steps": [["wait-tcp", "6379", "60"], ["exec", "redis-cli", "SET", "k10s", "trace"],

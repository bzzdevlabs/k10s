# Raspberry Pi 3/4/5 additions (mainline drivers; 6.18 has Pi 5 Ethernet via RP1 + macb). Size measurement only.
CONFIG_ARCH_BCM=y
CONFIG_ARCH_BCM2835=y
CONFIG_BCMGENET=y
CONFIG_MACB=y
CONFIG_MISC_RP1=y
CONFIG_PCIE_BRCMSTB=y
CONFIG_MMC=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PLTFM=y
CONFIG_MMC_SDHCI_IPROC=y
CONFIG_MMC_BCM2835=y
CONFIG_USB=y
CONFIG_USB_DWC2=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_PCI=y
CONFIG_USB_NET_DRIVERS=y
CONFIG_USB_USBNET=y
CONFIG_USB_NET_SMSC95XX=y
CONFIG_USB_LAN78XX=y
CONFIG_BCM2835_WDT=y
CONFIG_HW_RANDOM_BCM2835=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_BCM2835AUX=y
CONFIG_RASPBERRYPI_FIRMWARE=y
CONFIG_BCM2835_MBOX=y
CONFIG_CLK_RASPBERRYPI=y
CONFIG_PINCTRL_BCM2835=y
CONFIG_PINCTRL_BCM2712=y
CONFIG_RESET_RASPBERRYPI=y
CONFIG_REGULATOR=y
CONFIG_REGULATOR_FIXED_VOLTAGE=y
# menus/dependencies that tinyconfig leaves off
CONFIG_USB_SUPPORT=y
CONFIG_MAILBOX=y
CONFIG_OF_OVERLAY=y
CONFIG_PCI_QUIRKS=y
CONFIG_SERIAL_8250_SHARE_IRQ=y
CONFIG_PINCTRL_BRCMSTB=y
# 6.18.57: PINCTRL_RP1 uses regmap without selecting it; any REGMAP_MMIO user pulls it in
CONFIG_MFD_SYSCON=y

// compute.ten — Ten version of bench/workloads/compute (Go): CPU-bound SHA-256 chain.
//
// GET /?n=N computes h = sha256("k10s"), then N times h = sha256(h), and answers the lowercase hex digest of h
// followed by "\n". As in compute/main.go, N defaults to 1000 when it is absent, not an integer (Go Atoi rules),
// <= 0 or > 100_000_000. The output is byte-identical to the Go service.
//
// SHA-256 (FIPS 180-4) is implemented below in plain Ten: 32-bit words are kept zero-extended in i64 values and
// u32 storage truncates on store. A 32-bit rotation is one 64-bit rotation of the word duplicated into both
// halves: rotr(x | x << 32, n) has rotr32(x, n) in its low 32 bits.

data K: [u32; 64] = [
    0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
    0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
    0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
    0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
    0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
    0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
    0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
    0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2,
];

data H0: [u32; 8] = [
    0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a, 0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19,
];

const M32 = 0xFFFF_FFFF;

buffer state: [u32; 8];     // running hash value
buffer w: [u32; 64];        // message schedule
buffer block: [u8; 64];     // padded final block
buffer digest: [u8; 32];

// Processes one 64-byte block at p.
fn compress(p: *u8) {
    for i in 0..16 {
        let q = p + i * 4;
        w[i] = (q[0] << 24) | (q[1] << 16) | (q[2] << 8) | q[3];
    }
    for i in 16..64 {
        let x = w[i - 15];
        let xx = x | (x << 32);
        let s0 = (rotr(xx, 7) ^ rotr(xx, 18) ^ (x >> 3)) & M32;
        let y = w[i - 2];
        let yy = y | (y << 32);
        let s1 = (rotr(yy, 17) ^ rotr(yy, 19) ^ (y >> 10)) & M32;
        w[i] = w[i - 16] + s0 + w[i - 7] + s1;
    }
    let a = state[0];
    let b = state[1];
    let c = state[2];
    let d = state[3];
    let e = state[4];
    let f = state[5];
    let g = state[6];
    let h = state[7];
    for i in 0..64 {
        let ee = e | (e << 32);
        let s1 = (rotr(ee, 6) ^ rotr(ee, 11) ^ rotr(ee, 25)) & M32;
        let ch = (e & f) ^ (~e & g);
        let t1 = h + s1 + ch + K[i] + w[i];
        let aa = a | (a << 32);
        let s0 = (rotr(aa, 2) ^ rotr(aa, 13) ^ rotr(aa, 22)) & M32;
        let maj = (a & b) ^ (a & c) ^ (b & c);
        h = g;
        g = f;
        f = e;
        e = (d + t1) & M32;
        d = c;
        c = b;
        b = a;
        a = (t1 + s0 + maj) & M32;
    }
    state[0] += a;
    state[1] += b;
    state[2] += c;
    state[3] += d;
    state[4] += e;
    state[5] += f;
    state[6] += g;
    state[7] += h;
}

// SHA-256 of p[0..n] into out[0..32] (out may alias p).
fn sha256(p: *u8, n: i64, out: *u8) {
    memcpy(state, H0, 32);
    let off = 0;
    while off + 64 <= n {
        compress(p + off);
        off += 64;
    }
    let rem = n - off;
    memset(block, 0, 64);
    memcpy(block, p + off, rem);
    block[rem] = 0x80;
    if rem >= 56 {
        compress(block);
        memset(block, 0, 64);
    }
    let bits = n * 8;
    for i in 0..8 {
        block[63 - i] = bits >> (i * 8);
    }
    compress(block);
    for i in 0..8 {
        let v = state[i];
        let o = out + i * 4;
        o[0] = v >> 24;
        o[1] = v >> 16;
        o[2] = v >> 8;
        o[3] = v;
    }
}

export fn handle() {
    heap_reset();                       // query_int() reads paths of 1 KiB or more into the heap
    let n = query_int("n", 0);
    if n <= 0 || n > 100_000_000 {
        n = 1000;
    }
    sha256("k10s", 4, digest);
    for i in 0..n {
        sha256(digest, 32, digest);
    }
    out_hex_bytes(digest, 32);
    out_str("\n");
}

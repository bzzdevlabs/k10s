---
// Drawn terminal session. `session` lines: "$ cmd" is a command, "#> text" a comment, anything else output;
// output may color spans with «class:text» (red green yellow blue cyan magenta teal dim bold).
import Window from './Window.astro';

interface Props {
	session: string;
	title?: string;
	cwd?: string;
	caption?: string;
	animate?: boolean;
	variant?: 'terminal' | 'qemu';
}
const { session, title = 'Terminal', cwd = '~/k10s', caption, animate = false, variant = 'terminal' } = Astro.props;

const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
const markup = (s: string) =>
	esc(s).replace(/«([a-z]+):(.*?)»/g, (_, cls, text) => `<span class="t-${cls}">${text}</span>`);

function command(cmd: string) {
	const parts = cmd.match(/'[^']*'|"[^"]*"|\S+|\s+/g) ?? [];
	let first = true;
	return parts
		.map((p) => {
			if (/^\s+$/.test(p)) return p;
			let cls = 'arg';
			if (first) cls = 'bin';
			else if (p.startsWith('-')) cls = 'flag';
			else if (/^['"]/.test(p)) cls = 'str';
			else if (p === '|' || p === '&&' || p === '&') cls = 'op';
			first = p === '|' || p === '&&';
			return `<span class="c-${cls}">${esc(p)}</span>`;
		})
		.join('');
}

const rows = session.replace(/^\n/, '').replace(/\n\s*$/, '').split('\n');
const indent = Math.min(...rows.filter((r) => r.trim()).map((r) => r.length - r.trimStart().length));
const raw = rows.map((r) => r.slice(indent));
let t = 0.3;
const lines = raw.map((l) => {
	if (l.startsWith('$ ')) {
		const n = l.length - 2;
		const line = { kind: 'cmd', html: command(l.slice(2)), n, delay: t };
		t += n * 0.028 + 0.35;
		return line;
	}
	const kind = l.startsWith('#> ') ? 'comment' : 'out';
	const line = { kind, html: kind === 'comment' ? esc('#' + l.slice(2)) : markup(l) || ' ', n: 0, delay: t };
	t += 0.05;
	return line;
});
const prompt = `<span class="prompt"><span class="cwd">${esc(cwd)}</span> <span class="sig">$</span> </span>`;
const body =
	lines
		.map((l) =>
			l.kind === 'cmd'
				? `<span class="ln cmd" style="--d:${l.delay}s;--n:${l.n}">${prompt}<span class="typed">${l.html}</span></span>`
				: `<span class="ln ${l.kind}" style="--d:${l.delay}s">${l.html}</span>`,
		)
		.join('') + `<span class="ln" style="--d:${t}s">${prompt}<span class="cursor"></span></span>`;
---

<Window title={title} caption={caption} variant={variant}>
	<pre class:list={['term', { animate }]}><code set:html={body} /></pre>
</Window>

<style>
	.term {
		margin: 0;
		padding: 1rem 1.15rem 1.1rem;
		background: transparent;
		border: 0;
		font: 0.8rem/1.6 var(--sl-font-mono);
		color: #d6dee6;
		white-space: pre;
	}
	.term code {
		font: inherit;
		background: none;
		padding: 0;
		color: inherit;
	}
	:global(.term .ln) {
		display: block;
		min-height: 1.6em;
	}
	:global(.term .prompt) {
		user-select: none;
	}
	:global(.term .cwd) {
		color: #8fa1ff;
	}
	:global(.term .sig) {
		color: #4fd1c5;
	}
	:global(.term .comment) {
		color: #6b7d8f;
		font-style: italic;
	}
	:global(.term .c-bin) {
		color: #4fd1c5;
		font-weight: 600;
	}
	:global(.term .c-flag) {
		color: #a5b4fc;
	}
	:global(.term .c-str) {
		color: #f5c97a;
	}
	:global(.term .c-op) {
		color: #ef9aa5;
	}
	:global(.term .t-red) {
		color: #ff7b86;
	}
	:global(.term .t-green) {
		color: #7ee2a8;
	}
	:global(.term .t-yellow) {
		color: #f5c97a;
	}
	:global(.term .t-blue) {
		color: #82aaff;
	}
	:global(.term .t-cyan) {
		color: #7fdbea;
	}
	:global(.term .t-magenta) {
		color: #d9a7ff;
	}
	:global(.term .t-teal) {
		color: #4fd1c5;
	}
	:global(.term .t-dim) {
		color: #6b7d8f;
	}
	:global(.term .t-bold) {
		font-weight: 700;
		color: #fff;
	}
	:global(.term .cursor) {
		display: inline-block;
		width: 0.55em;
		height: 1.1em;
		vertical-align: text-bottom;
		background: #4fd1c5;
		animation: blink 1.1s steps(1) infinite;
	}
	@keyframes blink {
		50% {
			opacity: 0;
		}
	}
	@media (prefers-reduced-motion: no-preference) {
		:global(.term.animate .ln) {
			opacity: 0;
			animation: show 0.01s var(--d) forwards;
		}
		:global(.term.animate .cmd .typed) {
			display: inline-block;
			clip-path: inset(0 100% 0 0);
			animation: type calc(var(--n) * 0.028s) steps(var(--n)) var(--d) forwards;
		}
	}
	@keyframes show {
		to {
			opacity: 1;
		}
	}
	@keyframes type {
		to {
			clip-path: inset(0 0 0 0);
		}
	}
</style>
